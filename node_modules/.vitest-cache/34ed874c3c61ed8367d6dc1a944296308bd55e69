/**
* Centralized Motion Tokens & Easing Curves for AI Tathastu Insights
* Based on Phase 4 & Phase 5 specifications:
* - Restrained ease-out: [0.22, 1, 0.36, 1]
* - Button feedback: 150ms
* - Hover & focus: 250ms
* - Card transitions: 350ms
* - Section reveal: 650ms
* - Hero entrance: 850ms
*/
const MOTION_DURATIONS = {
	buttonFeedback: .15,
	hoverFocus: .25,
	cardTransition: .35,
	sectionReveal: .65,
	heroEntrance: .85
};
const EDITORIAL_EASE = [
	.22,
	1,
	.36,
	1
];
const GENTLE_EASE = [
	.16,
	1,
	.3,
	1
];
const motionTokens = {
	duration: MOTION_DURATIONS,
	ease: EDITORIAL_EASE
};
// Variants for line-by-line or word reveal
const heroHeadlineVariants = {
	hidden: {
		opacity: 0,
		y: 32
	},
	visible: (i = 0) => ({
		opacity: 1,
		y: 0,
		transition: {
			duration: MOTION_DURATIONS.heroEntrance,
			ease: EDITORIAL_EASE,
			delay: i * .12
		}
	})
};
const heroImageVariants = {
	hidden: {
		scale: 1.04,
		opacity: .9
	},
	visible: {
		scale: 1,
		opacity: 1,
		transition: {
			duration: 1.2,
			ease: EDITORIAL_EASE
		}
	}
};
// Section / Element Reveal Variants
const revealVariants = {
	hidden: {
		opacity: 0,
		y: 24
	},
	visible: {
		opacity: 1,
		y: 0,
		transition: {
			duration: MOTION_DURATIONS.sectionReveal,
			ease: EDITORIAL_EASE
		}
	}
};
const fadeVariants = {
	hidden: { opacity: 0 },
	visible: {
		opacity: 1,
		transition: {
			duration: MOTION_DURATIONS.sectionReveal,
			ease: EDITORIAL_EASE
		}
	}
};
// Stagger Container Variants
const staggerContainerVariants = {
	hidden: { opacity: 0 },
	visible: {
		opacity: 1,
		transition: {
			staggerChildren: .08,
			delayChildren: .05
		}
	}
};
const staggerItemVariants = {
	hidden: {
		opacity: 0,
		y: 20
	},
	visible: {
		opacity: 1,
		y: 0,
		transition: {
			duration: MOTION_DURATIONS.cardTransition,
			ease: EDITORIAL_EASE
		}
	}
};
// Interactive Button variants
const buttonTapTransition = {
	scale: .98,
	transition: {
		duration: MOTION_DURATIONS.buttonFeedback,
		ease: EDITORIAL_EASE
	}
};
// Modal Variants
const modalBackdropVariants = {
	hidden: { opacity: 0 },
	visible: {
		opacity: 1,
		transition: {
			duration: .25,
			ease: EDITORIAL_EASE
		}
	},
	exit: {
		opacity: 0,
		transition: {
			duration: .2,
			ease: EDITORIAL_EASE
		}
	}
};
const modalContentVariants = {
	hidden: {
		opacity: 0,
		scale: .96,
		y: 16
	},
	visible: {
		opacity: 1,
		scale: 1,
		y: 0,
		transition: {
			duration: .35,
			ease: EDITORIAL_EASE
		}
	},
	exit: {
		opacity: 0,
		scale: .96,
		y: 12,
		transition: {
			duration: .2,
			ease: EDITORIAL_EASE
		}
	}
};

