# AI Tathastu Insights — Production Environment Configuration
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL

# Server Configuration
PORT=3001
NODE_ENV=production

# Independent Database (PostgreSQL on Neon)
# Dedicated isolated database for AI Tathastu Insights
DATABASE_URL=postgresql://neondb_owner:YOUR_STRONG_PASSWORD_HERE@ep-tathastu-insights.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Application Security & Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_cryptographically_secure_random_key_min_32_characters

# Media Storage (Cloudinary Environment)
CLOUDINARY_CLOUD_NAME=tathastu-insights-prod
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Authoritative Registries & APIs
CROSSREF_MAILTO=research-desk@tathastu-insights.org
DATACITE_API_ENDPOINT=https://api.datacite.org/dois

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
